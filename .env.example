# Vercel: connect a PRIVATE Blob store in Project > Storage.
# The SDK uses BLOB_STORE_ID + Vercel-managed OIDC credentials automatically.
BLOB_STORE_ID=

# Alternative: private read-write token. Server-only, never NEXT_PUBLIC_.
BLOB_READ_WRITE_TOKEN=

# Self-hosted Node servers only, on a persistent disk (not Vercel).
# Local development without Blob credentials defaults to .data/shares.
SHARE_STORAGE_DIR=
